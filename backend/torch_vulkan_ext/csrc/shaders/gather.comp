#version 450
// Row-wise index: out[i] = in[offset + idx[i]]   (gather along the flattened array)
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufIn   { float in_data[]; };
layout(set = 0, binding = 1) buffer BufIdx  { uint  idx[]; };
layout(set = 0, binding = 2) buffer BufOut  { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint count;
    uint offset;
} params;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.count) return;
    out_data[i] = in_data[params.offset + idx[i]];
}
