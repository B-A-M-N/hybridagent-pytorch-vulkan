#version 450
// Quantized matrix multiply -- symmetric 4-bit, one fp16 scale per group.
//
//   C[M,N] = A[M,K] @ W[N,K]^T
//
// `A` is fp32 (activations). `W` is a byte buffer packed per output row:
//   row stride = group_size/2 + 2  bytes
//   per group:  2 bytes fp16 scale, then group_size/2 bytes of packed nibbles
// Quantization (host side): q = clamp(round(x/scale), -8, 7) + 8
// Dequantization:           x ~= (q - 8) * scale
//
// The weight buffer is declared as `uint w[]` because SPIR-V storage buffers
// are word-addressed; `byte_at()` extracts a byte from the containing word.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) buffer BufA { float a[]; };
layout(set = 0, binding = 1) buffer BufW { uint w[]; };   // packed bytes
layout(set = 0, binding = 2) buffer BufC { float c[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint N;
    uint tiles_x;
    uint group_size;
} params;

// Byte `i` of the packed weight buffer.
uint byte_at(uint i) {
    uint word = w[i / 4u];
    return (word >> ((i & 3u) * 8u)) & 0xFFu;
}

// fp16 (16 bits) -> fp32.
float half_to_float(uint h) {
    uint sgn = (h >> 15u) & 1u;
    uint exp = (h >> 10u) & 0x1Fu;
    uint man = h & 0x3FFu;
    float v;
    if (exp == 0u) {
        v = float(man) * 5.9604644775390625e-8;            // subnormal
    } else if (exp == 31u) {
        v = (man == 0u) ? 1.0 / 0.0 : 0.0;                 // inf / nan
    } else {
        v = float(man | 0x400u) * exp2(float(int(exp) - 25));
    }
    return (sgn == 1u) ? -v : v;
}

void main() {
    uint wg      = gl_WorkGroupID.x;
    uint tiles_x = params.tiles_x;
    uint col = (wg % tiles_x) * 16u + gl_LocalInvocationID.x;
    uint row = (wg / tiles_x) * 16u + gl_LocalInvocationID.y;
    if (row >= params.M || col >= params.N) return;

    // Bytes per packed group (scale + nibbles) and per packed row.
    uint group_bytes = uint(params.group_size / 2) + 2u;
    uint row_stride = (params.K / params.group_size) * group_bytes;
    uint row_base   = col * row_stride;

    float acc = 0.0;
    uint kg = params.K / params.group_size;
    for (uint g = 0u; g < kg; g++) {
        uint gbase = row_base + g * group_bytes;
        // scale is the first two bytes of the group, little-endian fp16
        uint h = byte_at(gbase) | (byte_at(gbase + 1u) << 8u);
        float sc = half_to_float(h);

        // then group_size packed nibbles
        uint qbase = gbase + 2u;
        for (uint j = 0u; j < params.group_size; j++) {
            uint k = g * params.group_size + j;
            if (k >= params.K) break;
            uint byte = byte_at(qbase + j / 2u);
            uint nib = ((j & 1u) == 0u) ? (byte & 0x0Fu) : (byte >> 4u);
            float wv = (float(nib) - 8.0) * sc;
            acc += a[row * params.K + k] * wv;
        }
    }
    c[row * params.N + col] = acc;
}
