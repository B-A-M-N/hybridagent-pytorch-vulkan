#version 450
// Quantized matrix multiply -- symmetric 4-bit, one fp16 scale per group.
//
//   C[M,N] = A[M,K] @ W[N,K]^T
//
// `A` is fp32. `W` is packed per output row:
//   group_bytes = group_size/2 + 2   (2 bytes fp16 scale, then nibbles)
//   row_stride  = (K / group_size) * group_bytes
//   quant: q = clamp(round(x/scale), -8, 7) + 8 ; dequant: x ~= (q - 8) * scale
//
// PERFORMANCE NOTE
// ----------------
// The first version of this kernel extracted bytes one at a time through a
// `byte_at()` helper and had no shared memory. It measured 4-5x SLOWER than the
// fp32 tiled kernel for batched work, because it became compute-bound on
// dequantization instead of bandwidth-bound.
//
// This version restructures the loop so each thread:
//   1. loads the group scales for its output row ONCE into registers
//   2. walks the K dimension in group_size chunks, unpacking two nibbles per
//      byte with cheap integer ops
// and stages the activation tile through shared memory exactly as the fp32
// kernel does, so the A traffic is amortised across the tile.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) buffer BufA { float a[]; };
layout(set = 0, binding = 1) buffer BufW { uint w[]; };
layout(set = 0, binding = 2) buffer BufC { float c[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint N;
    uint tiles_x;
    uint group_size;
} params;

#define TILE 16
shared float sA[TILE][TILE + 1];   // +1 avoids bank conflicts on the transpose

uint byte_at(uint i) {
    uint word = w[i / 4u];
    return (word >> ((i & 3u) * 8u)) & 0xFFu;
}

float half_to_float(uint h) {
    uint sgn = (h >> 15u) & 1u;
    uint exp = (h >> 10u) & 0x1Fu;
    uint man = h & 0x3FFu;
    float v;
    if (exp == 0u)       v = float(man) * 5.9604644775390625e-8;
    else if (exp == 31u) v = (man == 0u) ? 1.0 / 0.0 : 0.0;
    else                 v = float(man | 0x400u) * exp2(float(int(exp) - 25));
    return (sgn == 1u) ? -v : v;
}

void main() {
    uint wg      = gl_WorkGroupID.x;
    uint tiles_x = params.tiles_x;
    uint col = (wg % tiles_x) * TILE + gl_LocalInvocationID.x;
    uint row = (wg / tiles_x) * TILE + gl_LocalInvocationID.y;
    uint lx  = gl_LocalInvocationID.x;
    uint ly  = gl_LocalInvocationID.y;

    uint gs          = params.group_size;
    uint group_bytes = gs / 2u + 2u;
    uint kg          = params.K / gs;
    uint row_stride  = kg * group_bytes;
    uint row_base    = col * row_stride;

    float acc = 0.0;

    // Walk K in TILE-sized chunks so the activation tile is staged once.
    for (uint t0 = 0u; t0 < params.K; t0 += TILE) {
        // Stage A[row, t0+lx] for the whole tile row this thread owns.
        sA[ly][lx] = (row < params.M && (t0 + lx) < params.K)
                         ? a[row * params.K + t0 + lx] : 0.0;
        barrier();

        // This chunk may span several quant groups; handle them one at a time.
        uint t = t0;
        uint t_end = t0 + TILE;
        while (t < t_end) {
            uint g     = t / gs;
            uint goff  = t - g * gs;              // offset inside the group
            uint n_here = gs - goff;
            if (n_here > t_end - t) n_here = t_end - t;

            uint gbase = row_base + g * group_bytes;
            float sc = half_to_float(byte_at(gbase) |
                                     (byte_at(gbase + 1u) << 8u));

            // Unpack and accumulate the elements of this group that fall in the
            // current chunk. `j` indexes within the group.
            uint qbase = gbase + 2u + goff / 2u;
            uint j = goff;
            while (j < goff + n_here) {
                uint byte = byte_at(qbase);
                uint nib = ((j & 1u) == 0u) ? (byte & 0x0Fu) : (byte >> 4u);
                uint kk  = g * gs + j;
                acc += sA[ly][kk - t0] * ((float(nib) - 8.0) * sc);
                j++;
                qbase = gbase + 2u + j / 2u;
            }
            t += n_here;
        }
        barrier();
    }
    if (row < params.M && col < params.N) c[row * params.N + col] = acc;
}
