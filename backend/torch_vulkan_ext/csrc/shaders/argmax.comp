#version 450
// Global argmax over the whole [rows, cols] matrix, returned as a single uint.
//
// Parallel: thread tid starts at flat index tid and strides by the workgroup
// size, so the full matrix is covered concurrently; a 256-wide shared-memory
// reduction then picks the winner. Replaces an earlier version that reduced
// per row and then across rows, which produced wrong results on RADV at
// cols = 151671.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufIn    { float in_data[]; };
layout(set = 0, binding = 1) buffer BufOut   { uint  out_data[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
} params;

shared float s_val[256];
shared uint  s_idx[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint total = params.rows * params.cols;

    // Each thread finds its local max among elements it processes
    float best = -3.4e38;
    uint best_i = 0u;
    for (uint i = tid; i < total; i += 256u) {
        float v = in_data[i];
        if (v > best) { best = v; best_i = i; }
    }
    s_val[tid] = best;
    s_idx[tid] = best_i;
    barrier();

    // Tree reduction: each step halves the active threads.
    //
    // TIE-BREAK: on equal values, the LOWER index must win, to match
    // torch.argmax (which returns the first occurrence of the maximum).
    // The naive `s_val[tid + s] > s_val[tid]` takes the HIGHER index on a tie
    // because tid + s > tid, so the winner is the last occurrence instead of
    // the first. That is a real semantic difference from torch.argmax, not a
    // cosmetic one: it changes which token is sampled.
    //
    // The condition below therefore compares values first and falls back to
    // the index, so the smallest index survives every merge.
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) {
            float lhs_v = s_val[tid];
            float rhs_v = s_val[tid + s];
            uint  lhs_i = s_idx[tid];
            uint  rhs_i = s_idx[tid + s];
            bool take_rhs = (rhs_v > lhs_v) || (rhs_v == lhs_v && rhs_i < lhs_i);
            if (take_rhs) {
                s_val[tid] = rhs_v;
                s_idx[tid] = rhs_i;
            }
        }
        barrier();
    }
    if (tid == 0u) out_data[0] = s_idx[0];
}