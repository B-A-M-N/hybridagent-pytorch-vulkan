#version 450
// Copy a slice out of a larger buffer: out[i] = in[offset + i]
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufIn  { float in_data[]; };
layout(set = 0, binding = 1) buffer BufOut { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint count;
    uint offset;
} params;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.count) return;
    out_data[i] = in_data[params.offset + i];
}
