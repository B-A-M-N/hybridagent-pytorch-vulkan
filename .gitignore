# --- large / regenerable artifacts ---
weights/
.venv/
__pycache__/
*.pyc
*.pyo

# third_party: HybridAgent + torch-vulkan are VENDORED (MIT, tracked).
# Kompute is fetched by scripts/install.sh (pinned v0.9.0) and stays untracked.
third_party/kompute/
third_party/kompute_install/
third_party/torch-vulkan/build/
third_party/torch-vulkan/**/*.so
third_party/torch-vulkan/**/*.spv
third_party/HybridAgent/**/*.egg-info/

# build outputs -- regenerable with `make -C backend/torch_vulkan_ext/build`
backend/torch_vulkan_ext/build/
backend/torch_vulkan_ext/lib/*.so

# SPIR-V binaries are regenerable from the .comp sources via compile.sh.
# The .comp sources ARE committed; the .spv are not (see scripts/verify-backend.sh
# which rebuilds and hashes them).
backend/torch_vulkan_ext/csrc/shaders/*.spv

# runtime artifacts
logs/
*.log
benchmarks/*.json
benchmarks/*.csv
reports/*.html
